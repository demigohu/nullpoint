# Copy to .env and fill in. Never commit .env.

# testnet | mainnet
NETWORK=testnet

# Owner NEAR account (owner keys stay on the owner's machine, never on the agent host)
NEAR_ACCOUNT=nullpoint.testnet

# NEAR Intents partner key from https://partners.near-intents.org (1Click quotes and submit-intent)
NEAR_INTENTS_API_KEY=

# NEAR AI Cloud key (e.g. the $10 key from https://nearbuilders.org/dashboard), used by the strategist
NEARAI_API_KEY=

# Agent signing keys. Create them with `node scripts/add-agent-keys.ts`:
# function-call keys that can only call the vault (and, on testnet, the mock verifier).
AGENT_ACCOUNT=
AGENT_PRIVATE_KEY=
SOLVER_ACCOUNT=
SOLVER_PRIVATE_KEY=

# Hyperliquid agent wallet (trades only; approved by the vault via MPC). Falls back to .keys/hl-agent.json.
HL_AGENT_PRIVATE_KEY=

# Testnet only: the mock 1Click solver's Hyperliquid wallet. Falls back to .keys/mock-solver-hl.json.
SOLVER_HL_PRIVATE_KEY=

# Extra NEAR RPC endpoints, comma-separated, tried before the free public ones (e.g. a dRPC or
# FastNEAR URL with your API key). Strongly recommended for a 24/7 agent.
NEAR_RPC_URLS=

# Optional agent tuning
INTERVAL_S=60
STRATEGIST_INTERVAL_MIN=30
SITE_URL=            # public URL of the web app (share cards)

# Web app <-> docs links (defaults: localhost:3000 / localhost:3001)
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_REPO_URL=
