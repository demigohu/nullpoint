# Copy to .env and fill in. Never commit .env.

# testnet | mainnet
NETWORK=testnet

# Owner NEAR account (keys stay in the OS keychain via near-cli-rs)
NEAR_ACCOUNT=nullpoint.testnet

# NEAR Intents partner key from https://partners.near-intents.org
# Used for 1Click quotes (Authorization: Bearer) and the solver message bus.
NEAR_INTENTS_API_KEY=

# NEAR AI Cloud key (e.g. the $10 key claimed at https://nearbuilders.org/dashboard)
# Used by the LLM strategist.
NEARAI_API_KEY=
