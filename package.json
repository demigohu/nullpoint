{
  "name": "nullpoint",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "demo": "npm run demo -w @nullpoint/scripts --silent",
    "attack": "npm run attack -w @nullpoint/scripts --silent",
    "attack:llm": "npm run attack:llm -w @nullpoint/scripts --silent",
    "simulate:crash": "npm run simulate:crash -w @nullpoint/scripts --silent",
    "simulate:strategy": "npm run simulate:strategy -w @nullpoint/scripts --silent",
    "agent": "npm start -w agent"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ]
}
